# Threads App ID et Threads App Secret
# (tableau de bord Meta → cas d'usage Threads → Paramètres ; PAS la paire de l'app Meta)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Doit être exactement APP_URL + /api/auth/callback, et déclarée dans Meta
THREADS_REDIRECT_URI=https://example.vercel.app/api/auth/callback

# Origine publique de l'app, sans slash final
APP_URL=https://example.vercel.app

# Au moins 32 caractères aléatoires, par ex. : openssl rand -base64 48
SESSION_SECRET=
